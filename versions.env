# Every toolchain version this project's numbers were taken with.
#
# One file, read by three things: Dockerfile (ARGs), scripts/setup-wsl.sh, and
# bench/preflight.sh, which warns when what is installed does not match what is
# pinned here. A benchmark whose numbers cannot be tied to a toolchain version
# is a transcript, and until this file existed that was the situation for
# everything except Lean.
#
# Sourcing it in a shell is safe: no command substitution, no interpolation.
#
#   . versions.env && echo "$SB_GO_VERSION"

# ---- the base -------------------------------------------------------------
SB_UBUNTU=24.04

# Installed from Ubuntu's archive; the version follows from SB_UBUNTU, and is
# recorded so a mismatch is visible rather than assumed.
SB_GCC=13.3.0
SB_CLANG=18.1.3
SB_PERL=5.38.2
SB_PYTHON=3.12.3
SB_NUMPY=1.26.4
SB_OCAML=4.14.1
SB_JDK=21.0.11
SB_GFORTRAN=13.3.0

# ---- pinned by their own installers ---------------------------------------
SB_RUST=1.97.1
SB_GHC=9.10.3
SB_CABAL=3.16.1.0
SB_GO=1.27.0
SB_SWIFT=6.3.3
SB_NODE=25.5.0
SB_DOTNET_CHANNEL=10.0
SB_DOTNET=10.0.111

# impl/lean/lean-toolchain is the authority; elan reads it. Repeated here so
# one file answers "what was this built with".
SB_LEAN=leanprover/lean4:v4.33.0

# ---- the two Python targets that need their own interpreter ---------------
# numba pins a narrower numpy range than the system package, and the
# free-threaded build is a different binary. Both live in their own venv; see
# scripts/setup-wsl.sh.
SB_NUMBA_PYTHON=3.12
SB_NUMBA=0.67.0
SB_FREETHREADED_PYTHON=3.14.7

# ---- not in the container -------------------------------------------------
# CUDA and the GL compute targets need a GPU and a driver, which a container
# cannot carry. Recorded for the machine the published series ran on.
SB_CUDA=12.0.140
SB_GPU="NVIDIA RTX 5080, Mesa D3D12 under WSL2"

layout(local_size_x = 64) in;
uint rotl32(uint x, int k) { return (x << k) | (x >> (32 - k)); }
float wrapf(float v, float m) {
  if (v < 0.0) v = v + m;
  if (v >= m)  v = v - m;
  return v;
}
float senseAt(float x, float y, int d) {
  precise float sx = wrapf(x + costab[d] * uSensorDist, float(uWidth));
  precise float sy = wrapf(y + sintab[d] * uSensorDist, float(uHeight));
  return grid[((uint(sy) & uYmask) << uLog2w) | (uint(sx) & uXmask)];
}
void main() {
  uint i = gl_GlobalInvocationID.x
        + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (i >= uAgents) return;
  int d = int(adir[i]);
  float x = ax[i];
  float y = ay[i];
  int dl = (d - uSs + uNdir) % uNdir;
  int dr = (d + uSs) % uNdir;
  float fl = senseAt(x, y, dl);
  float fc = senseAt(x, y, d);
  float fr = senseAt(x, y, dr);
  if (fc >= fl && fc >= fr) {
  } else if (fc < fl && fc < fr) {
    uint o = i * 4u;
    uint s0 = arng[o], s1 = arng[o+1u], s2 = arng[o+2u], s3 = arng[o+3u];
    uint res = rotl32(s0 + s3, 7) + s0;
    uint t = s1 << 9;
    s2 ^= s0; s3 ^= s1; s1 ^= s2; s0 ^= s3; s2 ^= t; s3 = rotl32(s3, 11);
    arng[o] = s0; arng[o+1u] = s1; arng[o+2u] = s2; arng[o+3u] = s3;
    d = ((res & 1u) != 0u) ? (d + uRs) % uNdir : (d - uRs + uNdir) % uNdir;
  } else if (fl > fr) {
    d = (d - uRs + uNdir) % uNdir;
  } else {
    d = (d + uRs) % uNdir;
  }
  precise float nx = wrapf(x + costab[d] * uStep, float(uWidth));
  precise float ny = wrapf(y + sintab[d] * uStep, float(uHeight));
  x = nx;
  y = ny;
  uint idx = ((uint(y) & uYmask) << uLog2w) | (uint(x) & uXmask);
  atomicAdd(depcount[idx], 1u);
  adir[i] = uint(d);
  ax[i] = x;
  ay[i] = y;
}

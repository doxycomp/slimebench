// The diffusion and decay pass, SPEC-1 section 5.4, one cell per
// invocation.
//
// The accumulator is `precise`, which is what stops a driver
// reassociating the nine additions or contracting the 4.0*centre term
// into an FMA. It is not sufficient on its own: `precise` says nothing
// about the rounding of the division, which is why two of the three GPU
// backends still deviate from the CPU reference. docs/RESULTS.md section
// 9 has which ones and why.
layout(local_size_x = 64) in;
void main() {
  uint i = gl_GlobalInvocationID.x
        + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (i >= uCells) return;
  uint x = i & uXmask;
  uint y = i >> uLog2w;
  uint xm = (x - 1u) & uXmask;
  uint xp = (x + 1u) & uXmask;
  uint rowm = ((y - 1u) & uYmask) << uLog2w;
  uint row0 = y << uLog2w;
  uint rowp = ((y + 1u) & uYmask) << uLog2w;
  precise float acc = grid[rowm | xm];
  acc = acc + grid[rowm | x];
  acc = acc + grid[rowm | xp];
  acc = acc + grid[row0 | xm];
  acc = acc + 4.0 * grid[row0 | x];
  acc = acc + grid[row0 | xp];
  acc = acc + grid[rowp | xm];
  acc = acc + grid[rowp | x];
  acc = acc + grid[rowp | xp];
  scratch[row0 | x] = (acc / 12.0) * uDecay;
}
